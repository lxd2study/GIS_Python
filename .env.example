# Remote Sensing Tools environment variables

# Service
HOST=127.0.0.1
PORT=5001
DEBUG=false
LOG_LEVEL=INFO

# Data directories
DATA_DIR=./data
OUTPUT_DIR=./output
TEMP_DIR=./temp
CACHE_DIR=./cache
ALLOWED_PATH_ROOTS=

# 6S configuration
SIXS_EXECUTABLE_PATH=
DEFAULT_ATMOSPHERIC_PROFILE=2
DEFAULT_AEROSOL_PROFILE=1
DEFAULT_VISIBILITY=40.0

# Performance
MAX_WORKERS=4
CHUNK_SIZE=1024
ENABLE_CACHE=true

# GDAL
GDAL_CACHEMAX=512
GDAL_NUM_THREADS=ALL_CPUS

# Network
HTTP_TIMEOUT=60
LANDSAT_DOWNLOAD_DIR=./output/landsat_downloads
LANDSAT_EROS_USERNAME=
LANDSAT_EROS_PASSWORD=
LANDSAT_PROXY_URL=
LANDSAT_NO_PROXY=127.0.0.1,localhost
